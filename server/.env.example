# ============================================================
#  Hazaridevi Duck Farm - server environment template
#  Copy this file to ".env" and fill in your real values:
#      copy .env.example .env        (Windows)
#      cp .env.example .env          (Mac/Linux)
#  NEVER commit the real .env file.
# ============================================================

PORT=4000

# PostgreSQL connection (special chars in password: @ -> %40, # -> %23, : -> %3A)
DATABASE_URL="postgresql://postgres:YOUR_PG_PASSWORD@localhost:5432/Hazaridevi?schema=public"

# Emails that get ADMIN access. They register + verify like a normal customer, then log in
# on the normal Login page and land on the admin dashboard. Comma-separated.
ADMIN_EMAILS="admin@example.com"

# Long random string used to sign admin login tokens
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING"

# 📧 EMAIL SERVICE (Gmail SMTP -d use a 16-character Google App Password, not your normal password)
FARM_EMAIL="your-farm-email@gmail.com"
EMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"
# Address that gets CC'd on every dispatch slip (leave empty for none)
RAD_EMAIL=""
# Where "new order" alerts go (defaults to FARM_EMAIL)
ADMIN_NOTIFY_EMAIL=""
# "true" = print emails (with their links) in the server console instead of sending - handy for testing
EMAIL_DRY_RUN="false"

# 💳 KHALTI PAYMENT GATEWAY (from https://admin.khalti.com - use test_ keys for sandbox)
KHALTI_SECRET_KEY="test_secret_key_xxxxxxxxxxxxxxxxxxxxxxxx"
KHALTI_PUBLIC_KEY="test_public_key_xxxxxxxxxxxxxxxxxxxxxxxx"

# 💳 ESEWA (leave empty to use eSewa's public sandbox: EPAYTEST)
ESEWA_PRODUCT_CODE=""
ESEWA_SECRET_KEY=""

# 📱 SMS ALERTS TO ADMIN (Sparrow SMS - https://sparrowsms.com, Nepal). Leave empty to disable.
SPARROW_SMS_TOKEN=""
# Sender identity approved on your Sparrow account
SPARROW_SMS_FROM=""
# Number(s) that receive alerts, 10 digits, comma-separated
ADMIN_SMS_NUMBER="98XXXXXXXX"

# 💬 AUTOMATIC WHATSAPP ALERTS TO ADMIN (Meta WhatsApp Business Cloud API). Leave empty to disable.
# Setup: developers.facebook.com -> create app -> add "WhatsApp" -> copy token + phone number ID.
WHATSAPP_CLOUD_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Farm number(s) that receive alerts: country code + number, no "+" (e.g. 97798XXXXXXXX), comma-separated
WHATSAPP_ADMIN_TO=""
# Approved message template with one {{1}} body variable (needed to message the farm at any time)
WHATSAPP_TEMPLATE_NAME=""
WHATSAPP_TEMPLATE_LANG="en"

# 🌐 CLIENT URL (for payment success/failure redirects)
FRONTEND_URL="http://localhost:5173"

# 🔒 SECURITY
# "production" disables localhost/LAN CORS access - set this on the live server
NODE_ENV="development"
# Extra frontend origins allowed to call the API (comma-separated, no trailing slash)
CORS_ORIGINS=""
# Set to 1 when running behind a reverse proxy (Nginx, Render, Railway...) so rate limits see real IPs
TRUST_PROXY=""
